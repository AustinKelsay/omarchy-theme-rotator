#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly ROOT
readonly MANIFEST="$ROOT/manifest.json"

jq -e '
  .schemaVersion == 1
  and (.id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
  and (.name | type == "string" and length > 0)
  and (.version | type == "string" and test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))
  and (.kinds | type == "array" and length > 0)
  and (.entryPoints | type == "object")
  and (.kinds | index("service") != null)
  and (.kinds | index("bar-widget") != null)
  and .entryPoints.service == "Service.qml"
  and .entryPoints.barWidget == "BarWidget.qml"
  and .barWidget.defaultSection == "right"
' "$MANIFEST" >/dev/null

while IFS= read -r entry_point; do
  [[ $entry_point != /* && $entry_point != *..* ]]
  [[ -f $ROOT/$entry_point ]]
done < <(jq -r '.entryPoints[]' "$MANIFEST")

if find "$ROOT" -path "$ROOT/.git" -prune -o -type l -print -quit | grep -q .; then
  printf 'Plugin repositories may not contain symlinks.\n' >&2
  exit 1
fi

printf 'Plugin contract is valid.\n'
